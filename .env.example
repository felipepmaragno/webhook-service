# Copy this file to .env for local overrides.
# Values are safe development defaults. Do not commit .env.

# Compose project and host ports
COMPOSE_PROJECT_NAME=dispatch
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_HOST_PORT=29092
KAFKA_ADVERTISED_HOST=localhost
API_PORT=8090
WORKER_METRICS_PORT=8081
RECEIVER_PORT=9000
KAFKA_EXPORTER_PORT=9308
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# PostgreSQL development credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dispatch

# Host-local app configuration for running Go binaries directly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dispatch?sslmode=disable
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=events.pending
KAFKA_CONSUMER_GROUP=dispatch-workers
ADDR=:8080
METRICS_ADDR=:8081
INSTANCE_ID=worker-1
LOG_LEVEL=debug

# Container-internal service addresses used by docker-compose.yaml.
COMPOSE_DATABASE_URL=postgres://postgres:postgres@postgres:5432/dispatch?sslmode=disable
COMPOSE_REDIS_URL=redis://redis:6379/0
COMPOSE_KAFKA_BROKERS=kafka:9092
DISPATCH_API_BIND_ADDR=:8080

# Worker tuning
DB_MAX_CONNS=30
RETRY_POLL_INTERVAL=5s
RETRY_BATCH_SIZE=100
RETRY_MAX_CONCURRENT_BATCHES=2
RETRY_LEASE_DURATION=30s
ATTEMPT_BODY_RETENTION=168h
EVENT_RETENTION=720h
RETENTION_CLEANUP_INTERVAL=1h
RETENTION_BATCH_SIZE=1000

# Local receiver behavior
RECEIVER_FAIL_RATE=0
RECEIVER_LATENCY_MS=50
RECEIVER_JITTER_MS=20

# Makefile seed commands
API_ADDR=http://localhost:8090
RECEIVER_ADDR=http://receiver:9000
RECEIVER_CONTROL_ADDR=http://localhost:9000

# Grafana local credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
